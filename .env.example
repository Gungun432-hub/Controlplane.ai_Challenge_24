# Copy to .env (which is gitignored) and fill in.
# The offline provider is the reference runtime and needs none of this.
# NEVER commit .env. NEVER open it on a projector.

# ---------------------------------------------------------------- runtime ---
CONTROLPLANE_PROVIDER=offline
# CONTROLPLANE_PROVIDER=gemini
# GEMINI_API_KEY=

# Two applications call the model: the assistant that writes the answer, and the
# adjudicator that marks it. They can share one credential, and by default they
# do. Giving the judge its own key meters oversight separately — which is what
# turns "governance cost us this much" from a claim into a measurement — and
# stops a judge that runs out of quota from taking the assistant down with it.
# Optional. Unset, the judge uses GEMINI_API_KEY and nothing changes.
# GEMINI_JUDGE_API_KEY=

# A judge that is the same model as the writer is a model marking its own
# homework. Point this at a different one when you have the quota for it.
# CONTROLPLANE_JUDGE_MODEL=gemini-3.1-flash

CONTROLPLANE_OPERATOR_TOKEN=operator-dev-token
CONTROLPLANE_SEED_TURNS=110
CONTROLPLANE_AGENT_TIMEOUT_S=20

LEDGER_PATH=data/ledger.jsonl
LEDGER_SIGNING_KEY=development-only

# ------------------------------------------------- owner notifications ------
# Used by /advisor to email a system's owner their briefing.
# Configure ONE of the two transports. With neither, the briefing is still
# composed and the attempt is still recorded — it just is not delivered.

# The address the briefing is sent from. Required for the https transport.
# NOTIFY_FROM=ControlPlane <alerts@yourdomain.com>

# Both transports can be set at once. The first is tried, the second is used
# automatically if it fails — HTTPS survives a blocked SMTP port, SMTP reaches
# recipients an unverified sending domain cannot.
# NOTIFY_PREFER=smtp                 # try SMTP first instead

# --- Option A: an email API over HTTPS  *** WHAT WE USE ***
# Conference and campus networks routinely block outbound SMTP and almost never
# block 443. Measured from our own build container: smtp.gmail.com:587 and :465
# were both refused; api.resend.com:443 connected.
#
# Sending to an arbitrary recipient requires a VERIFIED DOMAIN. Ours is
# notifications.controlplane-demo.world (DKIM + SPF via Namecheap). Without one,
# Resend 403s every address except the account owner's.
# NOTIFY_API_URL=https://api.resend.com/emails
# NOTIFY_API_KEY=
# NOTIFY_API_STYLE=resend
# NOTIFY_FROM=ControlPlane <alerts@notifications.controlplane-demo.world>          # resend | brevo
#
# Brevo instead:
# NOTIFY_API_URL=https://api.brevo.com/v3/smtp/email
# NOTIFY_API_STYLE=brevo

# --- Option B: ordinary SMTP (Gmail needs an App Password, not your password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587                    # 587 STARTTLS, or 465 implicit TLS
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=                   # Google account -> Security -> App passwords
# SMTP_STARTTLS=1

# NOTIFY_TIMEOUT_S=12
