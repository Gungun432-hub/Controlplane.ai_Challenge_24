# Copy to .env and fill in. NEVER commit .env — it is gitignored.
# Google AI Studio key for the Gemini adapter (embeddings + LLM-as-judge).
GEMINI_API_KEY=
# Provider for embeddings + judge: "gemini" (live) or "offline" (no network, deterministic)
CONTROLPLANE_PROVIDER=offline
GEMINI_JUDGE_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=text-embedding-004
# HMAC key used to sign trust-ledger entries. Generate your own for any real use.
LEDGER_SIGNING_KEY=dev-only-not-a-secret
